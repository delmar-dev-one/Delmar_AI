import os
import shutil
from google.colab import drive

try:
    # 1. Verifica se o Drive está montado
    if not os.path.exists('/content/drive/MyDrive'):
        print("Remontando o Google Drive para garantir permissões de acesso...")
        drive.mount('/content/drive', force_remount=True)
    else:
        print("✔ Google Drive já está montado e acessível.")

    # 2. Definição robusta dos caminhos
    cnn_origem = '/content/AgroVisionAI_Project/AgroVisionAI/modelo_folhas.keras'
    yolo_origem = '/content/AgroVisionAI_Project/AgroVisionAI/runs/detect/AgroVisionAI_YOLO/treino_apple_tomato-2/weights/best.pt'
    destino_drive = '/content/drive/MyDrive/AgroVisionAI_Modelos'

    # Criando diretório de destino se não existir
    os.makedirs(destino_drive, exist_ok=True)
    print(f"✔ Pasta de destino confirmada: {destino_drive}")

    # 3. Cópia segura da CNN
    if os.path.exists(cnn_origem):
        shutil.copy2(cnn_origem, os.path.join(destino_drive, 'modelo_folhas.keras'))
        print("✔ Cópia de 'modelo_folhas.keras' realizada com sucesso!")
    else:
        print(f" Arquivo de origem não encontrado no caminho: {cnn_origem}")

    # 4. Cópia segura do YOLO
    if os.path.exists(yolo_origem):
        shutil.copy2(yolo_origem, os.path.join(destino_drive, 'best_yolo.pt'))
        print("✔ Cópia de 'best_yolo.pt' realizada com sucesso!")
    else:
        # Fallback para caminho alternativo do YOLO se o id do treino tiver mudado
        print("🔎 Buscando caminhos alternativos para os pesos do YOLO...")
        import glob
        alternativas = glob.glob('/content/AgroVisionAI_Project/AgroVisionAI/runs/detect/*/weights/best.pt')
        if alternativas:
            shutil.copy2(alternativas[0], os.path.join(destino_drive, 'best_yolo.pt'))
            print(f"✔ Cópia realizada com sucesso do caminho alternativo: {alternativas[0]}")
        else:
            print(" Nenhum arquivo 'best.pt' do YOLO foi localizado no projeto.")

except Exception as e:
    print(f" Ocorreu um erro inesperado: {str(e)}")
    print("Por favor, verifique se você concedeu as permissões necessárias na janela pop-up de login do Google Drive.")

